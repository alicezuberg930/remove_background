FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/workspace/.hf-cache

WORKDIR /workspace

RUN apt-get update \
&& apt-get install --no-install-recommends -y python3 python3-pip python3-venv libgomp1 \
&& rm -rf /var/lib/apt/lists/*

COPY requirements-train.txt /tmp/requirements-train.txt
RUN python3 -m pip install --upgrade pip \
&& python3 -m pip install --no-cache-dir -r /tmp/requirements-train.txt

CMD ["python3", "training/finetune_birefnet.py", "--help"]
