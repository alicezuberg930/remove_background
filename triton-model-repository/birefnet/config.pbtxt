name: "birefnet"
backend: "python"
max_batch_size: 8

input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [ 3, -1, -1 ]
  }
]

output [
  {
    name: "mask"
    data_type: TYPE_FP32
    dims: [ -1, -1 ]
  }
]

instance_group [
  {
    kind: KIND_AUTO
    count: 1
  }
]

parameters: {
  key: "model_id"
  value: { string_value: "ZhengPeng7/BiRefNet_HR-matting" }
}
parameters: {
  key: "device"
  value: { string_value: "" }
}
parameters: {
  key: "use_half"
  value: { string_value: "true" }
}
